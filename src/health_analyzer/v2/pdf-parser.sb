(version 1)
(deny default)
(allow file-read-metadata)
(allow file-read-data (literal "/"))
(allow file-read*
  (subpath (param "CODE_ROOT"))
  (subpath (param "PYTHON_ROOT"))
  (subpath (param "BASE_PYTHON_ROOT"))
  (subpath "/System/Library") (subpath "/usr/lib")
  (subpath "/Library/Apple/System/Library")
  (subpath "/private/etc") (subpath "/private/var/db")
  (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(allow process-exec (literal (param "PYTHON_EXEC")))
(deny process-fork)
(allow signal) (allow sysctl-read) (allow mach-lookup)
(deny mach-lookup
  (global-name "com.apple.securityd.general")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.security.XPCKeychainSandboxCheck"))
(allow ipc-posix*)
(allow file-write* (literal "/dev/null"))
(deny network*)
