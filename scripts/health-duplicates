#!/usr/bin/env python3
"""Find byte-identical files in one selected local profile; no writes or network.

Output contains private paths and hashes: keep it in the private conversation.
An incomplete scan cannot establish that a duplicate is absent.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from health_analyzer.file_archive import ArchiveError, load_profiles
from health_analyzer.duplicate_search import find_duplicates


class InvalidArguments(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise InvalidArguments


def main() -> int:
    parser = Parser(description=__doc__)
    parser.add_argument("--config", required=True, help="Existing private profile configuration")
    parser.add_argument("--profile", required=True, help="Explicit profile ID or label")
    parser.add_argument("--source", required=True, help="Explicit absolute source file path")
    try:
        args = parser.parse_args()
        result = find_duplicates(load_profiles(args.config), args.profile, args.source)
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
        return 0
    except InvalidArguments:
        print(json.dumps({"error": "invalid_arguments"}), file=sys.stderr)
        return 2
    except (ArchiveError, OSError, ValueError):
        # Do not echo source, profile, paths or exception inputs to logs.
        print(json.dumps({"error": "duplicate_search_unavailable"}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
