#!/usr/bin/env python3
"""Render a local macOS Seatbelt policy without checking in host paths."""

from __future__ import annotations

import argparse
import os
import stat
import tempfile
from pathlib import Path


def _directory(value: str, *, label: str) -> Path:
    path = Path(value).expanduser().resolve()
    if not path.is_dir() or path.is_symlink():
        raise ValueError(f"{label} must be an existing non-symlink directory")
    return path


def _write_atomic(target: Path, payload: str) -> None:
    if target.exists() and target.is_symlink():
        raise ValueError("render target must not be a symbolic link")
    parent = target.parent
    if not parent.is_dir() or parent.is_symlink():
        raise ValueError("render target parent must be a non-symlink directory")
    descriptor, temporary_name = tempfile.mkstemp(prefix=".policy-", dir=parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, target)
    finally:
        if temporary.exists():
            temporary.unlink()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("template")
    parser.add_argument("output")
    parser.add_argument("--project-root", required=True)
    parser.add_argument("--private-archive-root")
    args = parser.parse_args()

    project_root = _directory(args.project_root, label="project root")
    archive_root = (
        _directory(args.private_archive_root, label="private archive root")
        if args.private_archive_root
        else project_root / "private-archives"
    )
    template = Path(args.template)
    if not template.is_file() or template.is_symlink():
        raise ValueError("policy template must be a regular non-symlink file")
    text = template.read_text(encoding="utf-8")
    rendered = text
    for marker, value in {
        "__PROJECT_ROOT__": str(project_root),
        "__PRIVATE_ARCHIVE_ROOT__": str(archive_root),
        "__USER_HOME__": str(Path.home()),
    }.items():
        rendered = rendered.replace(marker, value)
    if "__" in rendered:
        raise ValueError("policy template contains an unresolved placeholder")
    _write_atomic(Path(args.output), rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
