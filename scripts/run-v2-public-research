#!/usr/bin/env python3
from pathlib import Path
import os
import sys

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "src"))
from health_analyzer.v2.cli import main

config = os.environ.get("HEALTH_ANALYZER_V2_CONFIG")
if not config:
    print('{"error":{"code":"configuration_required","message":"Set HEALTH_ANALYZER_V2_CONFIG to an explicit v2 configuration"}}', file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(main(["--config", config, "serve", "--zone", "public-research", "--transport", "stdio"]))
