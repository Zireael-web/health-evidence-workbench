{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.health-analyzer/schemas/answer-bundle.schema.json",
  "title": "AnswerBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "question", "claims", "created_at", "review_required", "limitations", "risk_envelope", "schema_version"],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "case_packet_id": {"type": ["string", "null"]},
    "evidence_packet_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "review_required": {"const": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "risk_envelope": {"$ref": "#/$defs/riskEnvelope"},
    "schema_version": {"const": "1.1"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "kind", "support_ids", "certainty", "conflicts_with", "caveats", "status"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "kind": {"enum": ["source_fact", "user_note", "calculated", "external_evidence", "inference", "guideline_recommendation"]},
          "support_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "certainty": {"enum": ["low", "moderate", "high", "not_applicable"]},
          "conflicts_with": {"type": "array", "items": {"type": "string"}},
          "caveats": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["extracted", "needs_review", "verified", "rejected"]}
        }
      }
    }
  },
  "$defs": {
    "riskEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "clinician_confirmation_required"],
      "properties": {
        "intent": {"enum": ["education", "personal_context", "clinical_action", "urgent_assessment"]},
        "clinician_confirmation_required": {
          "type": "boolean",
          "description": "Declares that confirmation is required; it is not evidence that confirmation was obtained."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"intent": {"const": "clinical_action"}}, "required": ["intent"]},
          "then": {"properties": {"clinician_confirmation_required": {"const": true}}},
          "else": {"properties": {"clinician_confirmation_required": {"const": false}}}
        }
      ]
    }
  }
}
