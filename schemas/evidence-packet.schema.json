{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.health-analyzer/schemas/evidence-packet.schema.json",
  "title": "EvidencePacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "question", "items", "reviewed_claims", "retrieved_at", "search_log", "limitations", "risk_envelope", "schema_version"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^evidence_[a-f0-9]{20,64}$"},
    "question": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "search_log": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/searchLogEntry"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "risk_envelope": {"$ref": "#/$defs/riskEnvelope"},
    "schema_version": {"const": "1.3"},
    "reviewed_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewedEvidenceClaim"}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "title", "source_type", "url", "retrieved_at", "identifiers", "limitations", "supersedes"],
        "properties": {
          "evidence_id": {"type": "string"},
          "title": {"type": "string"},
          "source_type": {"type": "string"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "published_at": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "organization": {"type": ["string", "null"]},
          "jurisdiction": {"type": ["string", "null"]},
          "identifiers": {"type": "object", "additionalProperties": {"type": "string"}},
          "study_design": {"type": ["string", "null"]},
          "population": {"type": ["string", "null"]},
          "effect": {"type": ["string", "null"]},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "source_grade": {"type": ["string", "null"]},
          "raw_grade": {"type": ["string", "null"]},
          "supersedes": {"type": "array", "items": {"type": "string"}},
          "content_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "riskEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "clinician_confirmation_required"],
      "properties": {
        "intent": {"enum": ["education", "personal_context", "clinical_action", "urgent_assessment"]},
        "clinician_confirmation_required": {
          "type": "boolean",
          "description": "Declares that confirmation is required; it is not evidence that confirmation was obtained."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"intent": {"const": "clinical_action"}}, "required": ["intent"]},
          "then": {"properties": {"clinician_confirmation_required": {"const": true}}},
          "else": {"properties": {"clinician_confirmation_required": {"const": false}}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "sha256", "locator", "page", "bbox", "line_start", "line_end", "char_start", "char_end", "excerpt"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locator": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {"type": ["array", "null"], "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 0},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "reviewedEvidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "question", "source_kind", "source_evidence_id", "source_snapshot_sha256", "statement_kind", "claim_type", "text", "provenance", "review_receipt_id", "reviewed_at", "reviewer_id", "verification", "population", "outcome", "effect", "native_grade_system", "native_grade", "limitations"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^evclaim_[a-f0-9]{32}$"},
        "question": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["retrieval_item", "guideline_recommendation"]},
        "source_evidence_id": {"type": "string", "minLength": 1},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "statement_kind": {"enum": ["external_evidence", "guideline_recommendation"]},
        "claim_type": {"enum": ["finding", "effect", "harm", "recommendation"]},
        "text": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review_receipt_id": {"type": "string", "pattern": "^eclaim_rcpt_[a-f0-9]{32}$"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "verification": {"const": "verified"},
        "population": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"]},
        "effect": {"type": ["string", "null"]},
        "native_grade_system": {"type": ["string", "null"]},
        "native_grade": {"type": ["string", "null"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "retrieval_item"}}},
          "then": {
            "properties": {
              "statement_kind": {"const": "external_evidence"},
              "claim_type": {"enum": ["finding", "effect", "harm"]}
            }
          }
        },
        {
          "if": {"properties": {"source_kind": {"const": "guideline_recommendation"}}},
          "then": {
            "properties": {
              "statement_kind": {"const": "guideline_recommendation"},
              "claim_type": {"const": "recommendation"},
              "native_grade_system": {"type": "string", "minLength": 1},
              "native_grade": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"claim_type": {"const": "effect"}}},
          "then": {"properties": {"effect": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "searchLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "source", "query_id", "executed_at", "query", "result_ids"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[a-f0-9]{20,64}$"},
        "source": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "executed_at": {"type": "string", "format": "date-time"},
        "query": {"type": "object"},
        "result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
