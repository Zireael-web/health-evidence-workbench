(version 1)

; Template rendered locally by scripts/render-sandbox-profile. Audit reads only
; public handoff data and project runtime inputs; it cannot use the network.
(deny default)
(allow file-read-metadata)
(allow file-read-data (literal "/"))
(allow file-read*
  (subpath "__PROJECT_ROOT__/src")
  (subpath "__PROJECT_ROOT__/schemas")
  (subpath "__PROJECT_ROOT__/policies")
  (subpath "__PROJECT_ROOT__/scripts")
  (subpath "__PROJECT_ROOT__/.venv")
  (subpath "__PROJECT_ROOT__/state/public")
  (subpath "__PROJECT_ROOT__/state/handoff/public")
  (subpath "__PROJECT_ROOT__/state/handoff/keys")
  (subpath "/System")
  (subpath "/usr")
  (subpath "/Library")
  (subpath "/private/etc")
  (subpath "/private/var/db")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(deny file-read*
  (subpath "__PROJECT_ROOT__/private-archives")
  (subpath "__PROJECT_ROOT__/state/private")
  (subpath "__PROJECT_ROOT__/state/synthesis")
  (literal "__PROJECT_ROOT__/.env"))
(allow process*)
(deny process-exec (literal "/usr/bin/security"))
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(deny mach-lookup
  (global-name "com.apple.securityd.general")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.security.XPCKeychainSandboxCheck"))
(allow ipc-posix*)
(allow file-write* (literal "/dev/null"))
(deny network*)
