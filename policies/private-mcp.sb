(version 1)

; Template rendered locally by scripts/render-sandbox-profile. Private MCP may
; read an explicitly configured archive root and write only local private state.
(deny default)
(allow file-read-metadata)
(allow file-read-data (literal "/"))
(allow file-read*
  (subpath "__PROJECT_ROOT__/src")
  (subpath "__PROJECT_ROOT__/schemas")
  (subpath "__PROJECT_ROOT__/policies")
  (subpath "__PROJECT_ROOT__/scripts")
  (subpath "__PROJECT_ROOT__/.venv")
  (subpath "__PRIVATE_ARCHIVE_ROOT__")
  (subpath "__PROJECT_ROOT__/state/private")
  (subpath "__PROJECT_ROOT__/state/handoff/private")
  (subpath "__PROJECT_ROOT__/state/handoff/keys")
  (literal "__USER_HOME__/Library/Keychains/login.keychain-db")
  (subpath "/System")
  (subpath "/usr")
  (subpath "/Library")
  (subpath "/private/etc")
  (subpath "/private/var/db")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(deny file-read*
  (literal "__PROJECT_ROOT__/.env")
  (subpath "__PROJECT_ROOT__/state/public")
  (subpath "__PROJECT_ROOT__/state/synthesis"))
(allow process*)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix*)
(allow file-write*
  (subpath "__PROJECT_ROOT__/state/private")
  (subpath "__PROJECT_ROOT__/state/handoff/private")
  (subpath "__PROJECT_ROOT__/state/handoff/keys")
  (literal "/dev/null"))
(deny network*)
