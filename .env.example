# Optional public bibliographic-metadata settings. Use an operator address,
# never a patient address.
NCBI_EMAIL=
NCBI_API_KEY=
CROSSREF_EMAIL=

# Required only by the bundled public-MCP configuration. Set this to the
# absolute path of this clone in your local environment; do not commit it.
HEALTH_ANALYZER_PROJECT_ROOT=/path/to/health-evidence-workbench

# Optional local state root for commands that support this setting. Never commit
# runtime state, whether it lives here or in the ignored project-local state/.
HEALTH_ANALYZER_STATE_ROOT=/path/to/private-state

# Private workflows only. Map opaque, non-identifying subject IDs to local
# archive directories. Do not commit real paths or source documents.
HEALTH_ANALYZER_PRIVATE_ARCHIVE_ROOT=/path/to/private-archives
HEALTH_ANALYZER_PRIVATE_ROOTS={"subject-alpha":"/path/to/private-archives/subject-alpha"}

# Supply a 32+ byte hex/base64 key through the environment or local keychain.
# Never put a real key in this file.
HEALTH_ANALYZER_PSEUDONYM_KEY=
